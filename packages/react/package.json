{
  "name": "@allfitone/react",
  "version": "0.1.0",
  "description": "React and Next.js adapters for the Allfit One design system.",
  "type": "module",
  "sideEffects": [
    "./dist/tokens.css",
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./brand": {
      "types": "./dist/brand.d.ts",
      "import": "./dist/brand.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./lib/utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tailwindcss -i src/styles/globals.css -o dist/styles.css --minify && node scripts/build.mjs",
    "test": "vitest run",
    "check": "npm run build && npm run test && node scripts/validate.mjs",
    "prepack": "npm run check"
  },
  "dependencies": {
    "@allfitone/brand": "*",
    "@allfitone/icons": "*",
    "@allfitone/tokens": "*",
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.14.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
