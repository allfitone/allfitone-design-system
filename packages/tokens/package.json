{
  "name": "@allfitone/tokens",
  "version": "0.4.1",
  "description": "Cross-platform design tokens for the Allfit One ecosystem.",
  "repository": {
    "type": "git",
    "url": "https://github.com/allfitone/allfitone-design-system.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/allfitone/allfitone-design-system#readme",
  "bugs": {
    "url": "https://github.com/allfitone/allfitone-design-system/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": [
    "./dist/tokens.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "check": "npm run build && node scripts/validate.mjs",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
