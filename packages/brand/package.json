{
  "name": "@allfitone/brand",
  "version": "0.3.0",
  "description": "Canonical brand assets and renderers for the Allfit One ecosystem.",
  "repository": {
    "type": "git",
    "url": "https://github.com/dinnartec/allfitone-design-system.git",
    "directory": "packages/brand"
  },
  "homepage": "https://github.com/dinnartec/allfitone-design-system#readme",
  "bugs": {
    "url": "https://github.com/dinnartec/allfitone-design-system/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "assets",
    "dist",
    "scripts/sync-assets.mjs",
    "README.md"
  ],
  "bin": {
    "allfitone-brand-assets": "./scripts/sync-assets.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./geometry": {
      "types": "./dist/geometry.d.ts",
      "import": "./dist/geometry.js"
    },
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:assets": "npm run build && node scripts/generate-product-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm run test && node scripts/validate.mjs",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
